Algoritmo "Exercicio12"
// Autor: Daniel Medeiros da Silva
// Data: 04/08/2026

Var // declaracao de variaveis
	i: inteiro
  
Inicio // inicio do programa
  // contagem regressiva de 10 ate 1
  para i de 10 ate 1 passo -1 faca
  	escreval(i)
 	fimpara
    escreval("Feliz Ano Novo!") // escreve "Feliz Ano Novo!" ao final da contagem

FimAlgoritmo // fim do programa