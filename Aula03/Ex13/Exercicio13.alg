Algoritmo "Exercicio13"
// Autor: Daniel Medeiros da Silva
// Data: 04/08/2026

Var // declaracao de variaveis
	i: inteiro
  
Inicio // inicio do programa
  // contagem de 1 ate 100
  para i de 1 ate 100 passo 1 faca
  	// escreve o numero se o resto da divisao por dois for zero
    se (i % 2 = 0) entao
    	escreval(i)
    fimse
 	fimpara

FimAlgoritmo // fim do programa